# Copy this file to .env.local for local work. On Vercel, add the same three names under Settings -> Environment Variables.

# From the Neon dashboard (Connect -> connection string). Leave empty locally to use a file in .data/ instead.
DATABASE_URL=

# The password you type on the sign-in page.
APP_PASSWORD=change-me-to-something-long

# Any long random text (32+ characters). Signs your login cookie. Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
